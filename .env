# Database Configuration
DB_HOST=vprodb
DB_PORT=3306
DB_NAME=accounts
DB_USERNAME=root
DB_PASSWORD=vprodbpass

# Memcached Configuration
MEMCACHED_ACTIVE_HOST=vprocache01
MEMCACHED_ACTIVE_PORT=11211
MEMCACHED_STANDBY_HOST=127.0.0.2
MEMCACHED_STANDBY_PORT=11211

# RabbitMQ Configuration
RABBITMQ_HOST=vpromq01
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# Elasticsearch Configuration
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9300
ELASTICSEARCH_CLUSTER=vprofile
ELASTICSEARCH_NODE=vprofilenode

# Application Configuration
SPRING_SECURITY_USER_NAME=admin_vp
SPRING_SECURITY_USER_PASSWORD=admin_vp
SPRING_SECURITY_USER_ROLES=ADMIN

# File Upload Configuration
MAX_FILE_SIZE=128KB
MAX_REQUEST_SIZE=128KB

# Logging Configuration
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_SECURITY=DEBUG
LOGGING_LEVEL_HIBERNATE=OFF
